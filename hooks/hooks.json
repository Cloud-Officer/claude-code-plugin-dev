{
  "description": "Block git worktrees created outside the repository, so stray sibling folders never pile up",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/worktree-guard.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
